<Window x:Class="SlateClean.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlateClean Dashboard" Height="480" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="#f9fafb">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="SlateClean Dashboard"
                   FontSize="24" FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="0,0,0,24"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#e5e7eb" BorderThickness="1"
                CornerRadius="8" Padding="20">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock HorizontalAlignment="Left"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#374151">
                        <Run Text="Drive "/>
                        <Run Text="{Binding DriveLabel}"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="#6b7280"
                               Text="{Binding FreeDisplay}"/>
                </Grid>

                <ProgressBar Height="14"
                             Minimum="0" Maximum="100"
                             Value="{Binding UsedPercent, Mode=OneWay}"
                             Foreground="#3b82f6"
                             Background="#f3f4f6"
                             BorderBrush="#e5e7eb"/>

                <TextBlock Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="#9ca3af"
                           HorizontalAlignment="Right">
                    <Run Text="{Binding UsedPercent, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                    <Run Text=" used"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
