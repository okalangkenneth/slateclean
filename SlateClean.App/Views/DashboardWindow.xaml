<Window x:Class="SlateClean.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlateClean Dashboard" Height="780" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="#f9fafb">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="SlateClean Dashboard"
                   FontSize="24" FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="0,0,0,24"/>

        <!-- Disk usage card -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#e5e7eb" BorderThickness="1"
                CornerRadius="8" Padding="20">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock HorizontalAlignment="Left"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#374151">
                        <Run Text="Drive "/>
                        <Run Text="{Binding DriveLabel, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="#6b7280"
                               Text="{Binding FreeDisplay}"/>
                </Grid>

                <ProgressBar Height="14"
                             Minimum="0" Maximum="100"
                             Value="{Binding UsedPercent, Mode=OneWay}"
                             Foreground="#3b82f6"
                             Background="#f3f4f6"
                             BorderBrush="#e5e7eb"/>

                <Grid Margin="0,8,0,0">
                    <TextBlock HorizontalAlignment="Left"
                               FontSize="11"
                               Foreground="#9ca3af">
                        <Run Text="Last updated: "/>
                        <Run Text="{Binding LastUpdatedDisplay, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#9ca3af">
                        <Run Text="{Binding UsedPercent, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                        <Run Text=" used"/>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Application caches card -->
        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Background="White"
                BorderBrush="#e5e7eb" BorderThickness="1"
                CornerRadius="8" Padding="20">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Text="Application caches"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#374151"
                                   VerticalAlignment="Center"/>
                        <TextBlock Margin="12,0,0,0"
                                   FontSize="12"
                                   Foreground="#6b7280"
                                   VerticalAlignment="Center">
                            <Run Text="Total: "/>
                            <Run Text="{Binding TotalCacheDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Padding="12,4"
                            Command="{Binding RefreshCacheSizesCommand}"
                            Content="Refresh"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding CacheApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <TextBlock HorizontalAlignment="Left"
                                           FontSize="13"
                                           Foreground="#111827"
                                           Text="{Binding AppName}"/>
                                <TextBlock HorizontalAlignment="Right"
                                           FontSize="13"
                                           FontFamily="Consolas"
                                           Foreground="#374151"
                                           Text="{Binding SizeDisplay}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,12,0,0"
                           FontSize="11"
                           Foreground="#9ca3af"
                           HorizontalAlignment="Left">
                    <Run Text="Scanned at: "/>
                    <Run Text="{Binding CachesScannedAtDisplay, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Cleanup history card -->
        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Background="White"
                BorderBrush="#e5e7eb" BorderThickness="1"
                CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock HorizontalAlignment="Left"
                               Text="Recent cleanups"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#374151"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            Padding="12,4"
                            Command="{Binding RefreshHistoryCommand}"
                            Content="Refresh"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentCleanups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontSize="12"
                                               Foreground="#6b7280"
                                               Text="{Binding TimestampDisplay}"/>
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               Foreground="#111827"
                                               Text="{Binding AppName}"/>
                                    <TextBlock Grid.Column="2"
                                               FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="#374151"
                                               HorizontalAlignment="Right"
                                               Text="{Binding FilesDeleted, StringFormat={}{0} files}"/>
                                    <TextBlock Grid.Column="3"
                                               FontSize="12"
                                               FontFamily="Consolas"
                                               Foreground="#374151"
                                               HorizontalAlignment="Right"
                                               Text="{Binding BytesFreedDisplay}"/>
                                    <TextBlock Grid.Column="4"
                                               FontSize="12"
                                               HorizontalAlignment="Right"
                                               Foreground="#374151"
                                               Text="{Binding StatusDisplay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
